# ============================================
# RAKSHANA 24/7 — Environment Configuration
# ============================================
# Copy this file to .env and fill in your values

# --- Flask ---
FLASK_APP=run.py
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=rakshana-dev-secret-change-in-production

# --- Database ---
DATABASE_URL=sqlite:///rakshana.db

# --- JWT ---
JWT_SECRET_KEY=rakshana-jwt-secret-change-in-production
JWT_ACCESS_TOKEN_EXPIRES=3600
JWT_REFRESH_TOKEN_EXPIRES=2592000

# --- Encryption (AES-256) ---
ENCRYPTION_KEY=rakshana-aes-256-key-must-be-32-bytes!!

# --- Redis / Celery ---
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# --- Telegram (Telethon) ---
TELEGRAM_API_ID=YOUR_TELEGRAM_API_ID
TELEGRAM_API_HASH=YOUR_TELEGRAM_API_HASH
TELEGRAM_PHONE=+91XXXXXXXXXX
TELEGRAM_CHANNELS=channel1,channel2,channel3

# --- Twilio (SMS/WhatsApp Alerts) ---
TWILIO_ACCOUNT_SID=YOUR_TWILIO_SID
TWILIO_AUTH_TOKEN=YOUR_TWILIO_TOKEN
TWILIO_FROM_NUMBER=+1XXXXXXXXXX
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# --- Scan Configuration ---
SCAN_INTERVAL_HOURS=4
THREAT_WATCH_THRESHOLD=40
THREAT_ALERT_THRESHOLD=70
THREAT_CRITICAL_THRESHOLD=90

# --- CORS ---
CORS_ORIGINS=http://localhost:3000,http://localhost:5000
