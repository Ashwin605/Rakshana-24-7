# ============================================
# RAKSHANA 24/7 — Environment Variables
# IMPORTANT: Copy this to .env and fill in values
# NEVER commit .env to version control
# ============================================

# Flask
FLASK_ENV=production
SECRET_KEY=your-secret-key-here-generate-with-secrets.token_urlsafe(32)

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/rakshana_prod

# JWT (Use secrets.token_urlsafe(32) to generate)
JWT_SECRET_KEY=your-jwt-secret-key-here

# Encryption (MUST be 32 bytes — use secrets.token_hex(16))
ENCRYPTION_KEY=your-32-byte-encryption-key-here

# Redis
REDIS_URL=redis://localhost:6379/0

# Celery
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# Telegram Scanner
TELEGRAM_API_ID=your-telegram-api-id
TELEGRAM_API_HASH=your-telegram-api-hash
TELEGRAM_PHONE=+1234567890
TELEGRAM_CHANNELS=channel1,channel2,channel3

# Twilio SMS/WhatsApp
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_FROM_NUMBER=+1234567890

# Threat Scoring Thresholds
SCAN_INTERVAL_HOURS=4
THREAT_WATCH_THRESHOLD=40
THREAT_ALERT_THRESHOLD=70
THREAT_CRITICAL_THRESHOLD=90

# Token Expiry (in seconds)
JWT_ACCESS_TOKEN_EXPIRES=3600
JWT_REFRESH_TOKEN_EXPIRES=2592000

# CORS (comma-separated)
CORS_ORIGINS=https://yourapp.com,https://www.yourapp.com
